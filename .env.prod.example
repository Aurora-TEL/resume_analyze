APP_NAME=Resume Analyzer API
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=replace-with-a-long-random-secret
API_PREFIX=/api

FRONTEND_PORT=80
BACKEND_PORT=8000
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

POSTGRES_DB=resume_analyzer
POSTGRES_USER=resume
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql+psycopg://resume:replace-with-a-strong-password@db:5432/resume_analyzer

REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=replace-with-a-long-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

UPLOAD_DIR=storage/resumes
MAX_UPLOAD_SIZE_MB=10

VITE_APP_TITLE=Resume Analyzer
VITE_API_BASE_URL=/api

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
